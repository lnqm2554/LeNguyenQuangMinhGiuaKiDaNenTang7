rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /products/{productId} {
      function validProduct() {
        return request.resource.data.keys().hasAll(['name', 'price', 'soluong', 'image'])
          && request.resource.data.keys().hasOnly(['name', 'price', 'soluong', 'image'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.price is number
          && request.resource.data.price >= 0
          && request.resource.data.soluong is int
          && request.resource.data.soluong >= 0
          && request.resource.data.image is string
          && request.resource.data.image.size() > 0;
      }

      allow read: if request.auth != null;
      allow create, update: if request.auth != null && validProduct();
      allow delete: if request.auth != null;
    }
  }
}
